<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ScanCode.App</RootNamespace>
    <AssemblyName>ScanCode</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>0.1.6</Version>
    <Authors>M-adrigal</Authors>
    <Product>扫码助手</Product>
    <Description>Screen QR scanner for Baidu Netdisk and Quark (Windows P0)</Description>
    <!-- WPF needs the PerMonitorV2 manifest; WinForms emits a warning about this manifest setting. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScanCode.Core\ScanCode.Core.csproj" />
    <ProjectReference Include="..\ScanCode.Capture\ScanCode.Capture.csproj" />
    <ProjectReference Include="..\ScanCode.Interop\ScanCode.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
